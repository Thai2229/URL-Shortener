{
  "name": "url-shortener",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "vercel-build": "sh scripts/vercel-build.sh",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.test.json",
    "format": "prettier --write .",
    "loadtest:seed": "tsx loadtest/seed.ts",
    "loadtest:smoke": "mkdir -p loadtest/results && ${K6:-k6} run loadtest/smoke.js",
    "loadtest:redirect": "mkdir -p loadtest/results && ${K6:-k6} run loadtest/redirect.js",
    "loadtest:mixed": "mkdir -p loadtest/results && ${K6:-k6} run loadtest/mixed.js",
    "loadtest:spike": "mkdir -p loadtest/results && ${K6:-k6} run loadtest/spike.js",
    "loadtest:ratelimit": "mkdir -p loadtest/results && ${K6:-k6} run loadtest/ratelimit.js",
    "loadtest": "loadtest/run.sh"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.3.0",
    "@vercel/functions": "^3.11.3",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}

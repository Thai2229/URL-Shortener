# Dev values only. Copy to .env; never commit .env.
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=urlshortener
POSTGRES_DB=urlshortener

# For running the API on the host (npm run dev). Compose overrides these for the api container.
DATABASE_URL=postgres://urlshortener:urlshortener@localhost:5432/urlshortener
REDIS_URL=redis://localhost:6379
PG_POOL_MAX=10
# Migrations take a session advisory lock and must not go through PgBouncer. Defaults to DATABASE_URL.
# MIGRATE_DATABASE_URL=postgres://urlshortener:urlshortener@localhost:5432/urlshortener
# Host port nginx publishes in Compose.
# HTTP_PORT=3000

# Used by integration tests only.
TEST_DATABASE_URL=postgres://urlshortener:urlshortener@localhost:5432/urlshortener_test

PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Rate limiting (per client IP, shared across replicas via Redis).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CREATE_MAX=20
RATE_LIMIT_REDIRECT_MAX=600
RATE_LIMIT_READ_MAX=120
# Leave unset unless behind a proxy/load balancer you control. Compose sets 1 (nginx). See docs/SCALING.md.
# On Vercel it defaults to true when VERCEL=1 and VERCEL_ENV is set; an explicit value wins.
# TRUST_PROXY=

# Seconds between click-count flushes to Postgres; 0 disables the timer.
CLICK_FLUSH_INTERVAL_SECONDS=5

# Prometheus metrics at GET /metrics. Unauthenticated unless METRICS_TOKEN (16+ chars) is set.
# On Vercel (VERCEL=1, never set it yourself) /metrics defaults to off unless METRICS_TOKEN is set, and
# /readyz is served only with a token and then needs the bearer too. Explicit METRICS_ENABLED wins.
METRICS_ENABLED=true
# METRICS_TOKEN=
# Compose forwards both. Set the token when a cloud load balancer or rootless/Docker Desktop networking
# makes every client look like a private address to nginx: it is the second line of defense for /metrics.
# Pin the PgBouncer image in Compose (1.21+). See docs/SCALING.md.
# PGBOUNCER_IMAGE=edoburu/pgbouncer:latest

# Vercel (docs/DEPLOY_VERCEL.md). Neon injects DATABASE_URL and DATABASE_URL_UNPOOLED, Upstash injects KV_URL.
# Migrations prefer MIGRATE_DATABASE_URL, then DATABASE_URL_UNPOOLED, then DATABASE_URL.
# A pooled (-pooler host) URL is refused unless MIGRATE_DATABASE_URL is set explicitly.
# BASE_URL: production defaults to VERCEL_PROJECT_PRODUCTION_URL, previews to VERCEL_URL.
# PG_POOL_IDLE_MS=10000
# REDIS_COMMAND_TIMEOUT_MS=500
# REDIS_CONNECT_TIMEOUT_MS=5000
# CRON_SECRET (16+ chars, openssl rand -hex 32) enables GET /api/cron/flush; Vercel sends it as a bearer token.
# CRON_SECRET=

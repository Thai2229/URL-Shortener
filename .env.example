# Dev values only. Copy to .env; never commit .env.
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=urlshortener
POSTGRES_DB=urlshortener

# For running the API on the host (npm run dev). Compose overrides these for the api container.
DATABASE_URL=postgres://urlshortener:urlshortener@localhost:5432/urlshortener
REDIS_URL=redis://localhost:6379
PG_POOL_MAX=10

# Used by integration tests only.
TEST_DATABASE_URL=postgres://urlshortener:urlshortener@localhost:5432/urlshortener_test

PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000
LOG_LEVEL=info
